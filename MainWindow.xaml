<Window x:Class="KFiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KFiler"
        mc:Ignorable="d"
        Title="KFiler" Height="400" Width="600"
            Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <DockPanel>
            <StatusBar DockPanel.Dock="Top" Height="30">
                <TextBlock Text="お気に入り" Margin="10,0,0,0" />
                <ComboBox Name="cbSelectFolder" Width="250" SelectionChanged="cbSelectFolder_SelectionChanged" />
                <Button x:Name="btSelectFolder" Click="btSelectFolder_Click" ToolTip="表示中のフォルダをお気に入りに登録" >
                    <Image Source="Icon/DirGo.ico" Width="15" Height="15" />
                </Button>
                <Button Name="btUpFolder" Click="btFileOpration_Click"  >
                    <Image Source="/Icon/UpFolder.GIF" Width="15" Height="15" />
                </Button>
                <Separator Width="2" />
                <Button Name="btCopyFile" Click="btFileOpration_Click"  >
                    <Image Source="Icon/copy.png" Width="15" Height="15" />
                </Button>
                <Button Name="btCutFile" Click="btFileOpration_Click"  >
                    <Image Source="Icon/cut.png" Width="15" Height="15" />
                </Button>
                <Button Name="btPasteFile" Click="btFileOpration_Click"  >
                    <Image Source="Icon/paste.png" Width="15" Height="15" />
                </Button>
                <Separator Width="2" />
                <Button Name="btCompareFolder" Click="btFileOpration_Click"  >
                    <Image Source="Icon/Compare.gif" Width="15" Height="15" />
                </Button>
                <Button Name="btFileSearch" Click="btFileOpration_Click"  >
                    <Image Source="Icon/Search.gif" Width="15" Height="15" />
                </Button>
                <Button Name="btGrep" Click="btFileOpration_Click"  >
                    <Image Source="/Icon/SearchWord.gif" Width="15" Height="15" />
                </Button>
            </StatusBar>
            <StatusBar DockPanel.Dock="Bottom" Height="25">
                <Button Name="btSetting" Click="btSetting_Click" >
                    <Image Source="/Icon/Settings.png" Width="15" Height="15" />
                </Button>
                <TextBlock Name="tbStatus" Text="状態" Margin="10,0,0,0" />
                <StatusBarItem HorizontalAlignment="Right" >
                    <Button Name="btHelp" HorizontalAlignment="Right" Click="btHelp_Click">
                        <Image Source="/Icon/StatusHelpOutline.png" Width="15" Height="15" />
                    </Button>
                </StatusBarItem>
            </StatusBar>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*" x:Name="directoryTree"/>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>
                <TreeView Grid.Column="0" Name="tvComponent" SelectedItemChanged="tvComponent_SelectedItemChanged" >
                </TreeView>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                <ListView Grid.Column="2" Name="lvFileList" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="lvFileList_SelectionChanged" MouseDoubleClick="lvFileList_MouseDoubleClick" 
                          GridViewColumnHeader.Click="lvFileListColumnHeader_Click" >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- ListView の列（セル）に左揃え・中央揃え・右揃えを設定するのに必要な定義 -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="Auto" Header="名前">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16"  Source="{Binding mIcon}"></Image>
                                            <TextBlock TextAlignment="Left" Text="{Binding mName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="120" Header="日時">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Right" Text="{Binding mDateTime}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="Auto" Header="サイズ">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="Auto" HorizontalAlignment="Right" Text="{Binding mSize}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="Auto" Header="属性">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding mAttribute}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="lvCopyMenu" Header="コピー [Ctrl+C]" Click="lvFileList_MenuItem_Click" />
                            <MenuItem Name="lvCutMenu" Header="切り取り [Ctrl+X]" Click="lvFileList_MenuItem_Click" />
                            <MenuItem Name="lvPasteMenu" Header="貼付け [Ctrl+V]" Click="lvFileList_MenuItem_Click" />
                            <MenuItem Header="ファイル操作" >
                                <MenuItem Name="lvFileCopyMenu" Header="ファイルコピー [C]" Click="lvFileList_MenuItem_Click" />
                                <MenuItem Name="lvFileMoveMenu" Header="ファイル移動 [M]" Click="lvFileList_MenuItem_Click" />
                                <MenuItem Name="lvFileRenameMenu" Header="ファイル名の変更 [R]" Click="lvFileList_MenuItem_Click" />
                                <MenuItem Name="lvFileRemoveMenu" Header="削除 [D]" Click="lvFileList_MenuItem_Click" />
                                <MenuItem Name="lvMkdirMenu" Header="フォルダ作成 [K]" Click="lvFileList_MenuItem_Click" />
                                <MenuItem Name="lvFileCompressMenu" Header="圧縮 [Ctrl+P]" Click="lvFileList_MenuItem_Click" />
                            </MenuItem>
                            <MenuItem Name="lvOpenMenu" Header="開く [Ctrl+O]" Click="lvFileList_MenuItem_Click" />
                            <MenuItem Name="lvPropertyMenu" Header="プロパティ" Click="lvFileList_MenuItem_Click" />
                            <MenuItem Name="lvTerminalMenu" Header="ターミナルで開く [T]" Click="lvFileList_MenuItem_Click" />

                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Grid>

        </DockPanel>
    </Grid>
</Window>

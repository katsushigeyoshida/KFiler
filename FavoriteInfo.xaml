<Window x:Class="KFiler.FavoriteInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KFiler"
        mc:Ignorable="d"
        Title="FavoriteInfo" Height="260" Width="400" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <TextBlock Text="タイトル" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBox Name="tbTitle" Text="タイトル" Margin="80,0,10,0" VerticalAlignment="Top" />
        <TextBlock Text="分類" Margin="10,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBox Name="tbCategory" Text="分類" Margin="80,25,60,0" VerticalAlignment="Top" />
        <Button Name="btAddCategory" Content="追加" Margin="0,25,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btAddCategory_Click" />
        <TextBlock Text="ファイル種別" Margin="10,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Name="tbExtension" Text="拡張子" Margin="80,50,10,0" VerticalAlignment="Top" />
        <TextBlock Text="最書込日時" Margin="10,75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Name="tbDateTime" Text="日時" Margin="80,75,10,0" VerticalAlignment="Top" />
        <TextBlock Text="サイズ" Margin="10,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Name="tbSize" Text="サイズ" Margin="80,100,10,0" VerticalAlignment="Top" />
        <TextBlock Text="ファイルパス" Margin="10,125,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Name="tbPath" Text="パス" Margin="80,125,10,0" VerticalAlignment="Top" />
        <TextBlock Text="起動アプリ" Margin="10,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <ComboBox Name="cbApplication" IsEditable="True" Margin="80,150,10,0" VerticalAlignment="Top" MouseDoubleClick="cbApplication_MouseDoubleClick" />
        <Button Name="btOK" Content="OK" Width="40" Margin="0,185,70,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btOK_Click" />
        <Button Name="btCancel" Content="Cancel" Width="40" Margin="0,185,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btCancel_Click" />
    </Grid>
</Window>
